# Copy to .env.local and fill in. Never commit .env.local.

# AI providers (configure one or both)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gmail SMTP — use an App Password (Google Account > Security > 2-Step Verification > App passwords)
GMAIL_USER=
GMAIL_APP_PASSWORD=
SENDER_NAME=Jasser Nahali

# Optional job sources (free keys)
JOOBLE_API_KEY=        # https://jooble.org/api/about — covers Portugal, Denmark, Switzerland
ADZUNA_APP_ID=         # https://developer.adzuna.com — covers Switzerland
ADZUNA_APP_KEY=

# Optional contact finder (v4)
HUNTER_API_KEY=        # https://hunter.io/api-keys — 25 free searches/month
